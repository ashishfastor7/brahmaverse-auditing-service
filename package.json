{
  "name": "brahmaverse-auditing-service",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "migrate": "bun src/db/migrate.ts",
    "migrate:down": "bun src/db/migrate.ts down",
    "replay": "bun src/scripts/replay.ts",
    "eval:planted": "bun src/scripts/eval-planted.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "test:db": "AUDIT_TEST_DB=true bun test .db.test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.826.0",
    "@aws-sdk/s3-request-presigner": "^3.826.0",
    "@fastor7/message-bus": "^0.0.19",
    "@t3-oss/env-core": "^0.13.11",
    "dotenv": "^16.6.1",
    "hono": "^4.10.7",
    "openai": "^6.0.0",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "umzug": "^3.8.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.3",
    "@types/pg": "^8.11.0",
    "typescript": "^5.6.0"
  },
  "prettier": {
    "printWidth": 140,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "arrowParens": "always",
    "endOfLine": "lf"
  }
}
