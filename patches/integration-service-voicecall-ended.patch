+/** Subject published once per finalized call, for consumers that analyse finished calls (e.g. the auditing service). */
+export const VOICECALL_ENDED_SUBJECT = "voicecall.ended";
+
+type CallEndedSource = {
+  id: number;
+  business_id: number;
+  agent_id: number;
+  status: string;
+  call_type: string;
+  provider?: string | null;
+  voice_provider?: string | null;
+  provider_call_id?: string | null;
+  is_playground?: boolean | null;
+  data?: any;
+  picked_at?: string | null;
+  ends_at?: string | null;
+  duration?: number | null;
+  ended_reason?: string | null;
+  recording_url?: string | null;
+  summary?: string | null;
+  transcriptions?: { speaker: string; text: string }[] | null;
+  outcome?: Record<string, string | number> | null;
+  meta_data?: any;
+  tags?: string[] | null;
+  system_ref_id?: string | null;
+  conversation_ref?: string | null;
+  created_at?: string | Date | null;
+};
+
+/**
+ * The `voicecall.ended` payload: everything about a finished call that is useful without reading
+ * this service's DB. `agent_code`, `prompt_code` and the prompt's template `variables` (job
+ * details, screening questions — what an auditor checks the agent's claims against) only live
+ * inside the queued `data` payload, so they are lifted out here; the rest of `data` (phone
+ * numbers, tool config, callback subjects) is deliberately left out.
+ */
+export function buildCallEndedEvent(log: CallEndedSource) {
+  return {
+    id: log.id,
+    business_id: log.business_id,
+    agent_id: log.agent_id,
+    agent_code: (log.data?.agent_code as string | undefined) ?? null,
+    prompt_code: (log.data?.config?.prompt_code as string | undefined) ?? null,
+    callflow_id: (log.data?.config?.callflow_id as number | undefined) ?? null,
+    variables: (log.data?.config?.variables as Record<string, string | number | boolean> | undefined) ?? {},
+    status: log.status,
+    call_type: log.call_type,
+    provider: log.provider ?? null,
+    voice_provider: log.voice_provider ?? null,
+    provider_call_id: log.provider_call_id ?? null,
+    is_playground: Boolean(log.is_playground),
+    picked_at: log.picked_at ?? null,
+    ends_at: log.ends_at ?? null,
+    duration: log.duration ?? null,
+    ended_reason: log.ended_reason ?? null,
+    recording_url: log.recording_url ?? null,
+    summary: log.summary ?? null,
+    transcriptions: log.transcriptions ?? [],
+    outcome: log.outcome ?? null,
+    meta_data: log.meta_data ?? null,
+    tags: log.tags ?? [],
+    system_ref_id: log.system_ref_id ?? null,
+    conversation_ref: log.conversation_ref ?? null,
+    created_at: log.created_at ?? null,
+  };
+}
+
+export type CallEndedEvent = ReturnType<typeof buildCallEndedEvent>;
