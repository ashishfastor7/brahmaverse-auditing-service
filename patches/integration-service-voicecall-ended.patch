+describe("buildCallEndedEvent", () => {
+  const log = {
+    id: 42,
+    business_id: 10,
+    agent_id: 3,
+    status: "completed",
+    call_type: "outbound",
+    voice_provider: "brahmaverse",
+    is_playground: false,
+    data: {
+      agent_code: "hrms",
+      config: { prompt_code: "screening_v2", channel: "plivo", variables: { job_title: "QA Engineer", ctc_range: "6-8 LPA" } },
+      metadata: { phone: "+919999999999" },
+      on_success: "hrms.call.success",
+    },
+    duration: 95,
+    ended_reason: "hangup",
+    recording_url: "https://bucket/private/10/recodings/a.wav",
+    summary: "Candidate screened.",
+    transcriptions: [
+      { speaker: "agent", text: "Hi, this is Hansa." },
+      { speaker: "user", text: "Hello." },
+    ],
+    outcome: { notice_period: "30" },
+  };
+
+  it("lifts agent_code, prompt_code and variables out of the queued payload", () => {
+    const event = buildCallEndedEvent(log);
+    expect(event.agent_code).toBe("hrms");
+    expect(event.prompt_code).toBe("screening_v2");
+    expect(event.variables).toEqual({ job_title: "QA Engineer", ctc_range: "6-8 LPA" });
+    expect(event.transcriptions).toHaveLength(2);
+    expect(event.outcome).toEqual({ notice_period: "30" });
+  });
+
+  it("does not leak the rest of the queued payload (phone, callback subjects)", () => {
+    const event = buildCallEndedEvent(log) as Record<string, unknown>;
+    expect(event.data).toBeUndefined();
+    expect(JSON.stringify(event)).not.toContain("+919999999999");
+    expect(JSON.stringify(event)).not.toContain("hrms.call.success");
+  });
+
+  it("fills missing optional fields with null / empty defaults", () => {
+    const event = buildCallEndedEvent({ id: 1, business_id: 1, agent_id: 1, status: "no_answer", call_type: "outbound" });
+    expect(event.agent_code).toBeNull();
+    expect(event.variables).toEqual({});
+    expect(event.transcriptions).toEqual([]);
+    expect(event.is_playground).toBe(false);
+    expect(event.recording_url).toBeNull();
+  });
+});
