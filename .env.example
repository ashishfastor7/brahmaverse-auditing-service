# Audit results database (the service's own; it never writes to other services' databases)
DB_HOSTNAME=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=brahmaverse_audit
DB_SSL=false

# Message bus (same NATS the other services use; it always dials nats://0.0.0.0:4222)
MESSAGE_BUS_USERNAME=brainey
MESSAGE_BUS_PASSWORD=

# LLM judge
OPENAI_API_KEY=
AUDIT_JUDGE_MODEL=gpt-5.6-luna
# Set for reasoning models (minimal|low|medium|high); leave empty to send temperature 0 instead
AUDIT_JUDGE_REASONING_EFFORT=medium

# Behaviour
PORT=8095
# Bearer token the dashboard sends to the API
AUDIT_API_TOKEN=change-me
# Subscribe to voicecall.ended on startup (set false to run the API only)
AUDIT_SUBSCRIBE=true
# Audit playground calls too (useful on dev, off in production)
AUDIT_INCLUDE_PLAYGROUND=false
# Audits below this confidence are flagged for human review
AUDIT_REVIEW_THRESHOLD=0.7
